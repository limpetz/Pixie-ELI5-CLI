{
  "name": "pixie",
  "version": "0.1.0",
  "description": "Pixie — a local-first AI coding & reasoning agent. Phase 1 of the Pixie model roadmap.",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "bin": {
    "pixie": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build-dataset": "tsx scripts/build-dataset.ts",
    "build-round8": "tsx scripts/build-round8.ts",
    "build-round9": "tsx scripts/build-round9.ts",
    "build-round10": "tsx scripts/build-round10.ts",
    "prepare-training": "tsx scripts/prepare-training.ts",
    "distill": "tsx scripts/distill.ts",
    "eval": "tsx scripts/eval.ts",
    "selftest": "tsx scripts/selftest.ts",
    "verify-smoke": "tsx scripts/verify-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
